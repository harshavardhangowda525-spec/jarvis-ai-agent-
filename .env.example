# ==========================================================================
# JARVIS AI — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# JARVIS degrades gracefully: missing keys disable the related capability
# (voice / search / weather) but the rest of the app keeps working.
# ==========================================================================

# --- Database (required) -------------------------------------------------
# PostgreSQL connection string. Works with Supabase, Neon, RDS, or local PG.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/jarvis?schema=public"

# --- Auth (required) -----------------------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public base URL of the app (used for OAuth callbacks). No trailing slash.
APP_URL="http://localhost:3000"

# --- AI model (required for reasoning) -----------------------------------
# JARVIS supports multiple providers. Pick ONE:
#
#   AI_PROVIDER=gemini    -> set GEMINI_API_KEY   (FREE at aistudio.google.com)
#   AI_PROVIDER=groq      -> set GROQ_API_KEY     (FREE at console.groq.com)
#   AI_PROVIDER=ollama    -> local models, unlimited & private (needs Ollama)
#   AI_PROVIDER=openai    -> set OPENAI_API_KEY   (+ optional OPENAI_BASE_URL)
#   AI_PROVIDER=anthropic -> set AI_API_KEY       (paid, console.anthropic.com)
#
# Switch quickly with:  npm run use:groq  |  npm run use:ollama
# (For the deployed app, change AI_PROVIDER in the Vercel dashboard instead.)
#
# AUTOMATIC FALLBACK: set several keys and JARVIS uses AI_PROVIDER first, then
# automatically falls back to any other configured provider when one is rate-
# limited or errors. Combining free tiers (Groq + Gemini + OpenRouter) makes it
# effectively never run out. Order tried: groq -> gemini -> openrouter ->
# openai -> anthropic -> ollama (skipping any without a key).
#
# If AI_PROVIDER is blank, it is inferred from whichever key below is present.
AI_PROVIDER="groq"

# Google Gemini (recommended free option). Uses the OpenAI-compatible endpoint.
GEMINI_API_KEY=""

# Groq (free, very fast). Runs Llama models with tool-calling.
GROQ_API_KEY=""

# OpenRouter (one key, many models — including free ones). Great as a fallback.
# Get a key at https://openrouter.ai/keys. Optionally pin a model:
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""   # default: meta-llama/llama-3.3-70b-instruct:free

# Ollama (local, unlimited, private). Install from ollama.com, then:
#   ollama pull llama3.1   (use a tool-capable model so JARVIS tools work)
# Only reachable from where the app runs — great for local dev; the Vercel
# deployment can't reach your localhost unless you expose it via a tunnel.
OLLAMA_BASE_URL="http://localhost:11434/v1"

# OpenAI or any OpenAI-compatible endpoint.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Anthropic (paid). Powerful, native PDF/vision support.
AI_API_KEY=""

# Optional model override. Sensible per-provider defaults are used if blank:
#   gemini -> gemini-3.6-flash | groq -> llama-3.3-70b-versatile
#   openai -> gpt-4o-mini      | anthropic -> claude-sonnet-5
AI_MODEL=""

# --- ElevenLabs Voice (optional) -----------------------------------------
# Server-side only. Never exposed to the browser.
ELEVENLABS_API_KEY=""
# Voice used for JARVIS speech. Configurable — do not hard-code in code.
ELEVENLABS_VOICE_ID=""
# Low-latency conversational model. eleven_turbo_v2_5 recommended.
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
# Speech-to-text model for microphone transcription.
ELEVENLABS_STT_MODEL_ID="scribe_v1"

# --- Web Search (optional) -----------------------------------------------
# Tavily API key (https://tavily.com) powers the web_search tool.
SEARCH_API_KEY=""

# --- Weather (optional) --------------------------------------------------
# OpenWeatherMap API key (https://openweathermap.org/api).
WEATHER_API_KEY=""

# --- OAuth integrations (optional) ---------------------------------------
# Only fill these for integrations you want to enable. Left blank => disabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# --- EV marketing agent (optional) ---------------------------------------
# EV is JARVIS's marketing/growth agent for Infinity Web & Apps. It reuses the
# same AI provider chain and voice above — these vars only add its integrations.
#
# Instagram: EV can read profile/media/insights and (after your approval)
# publish. Two token flavors are auto-detected:
#   - "Instagram API with Instagram Login" tokens start with "IG" and use
#     graph.instagram.com; INSTAGRAM_BUSINESS_ID may be left blank ("me").
#   - Facebook-linked Instagram Graph API tokens need INSTAGRAM_BUSINESS_ID.
# Server-side only — never exposed to the browser.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""
INSTAGRAM_GRAPH_VERSION="v21.0"
# DARWIN lead-discovery service (optional). If unset, EV honestly reports that
# lead discovery isn't connected and never invents businesses or phone numbers.
DARWIN_API_URL=""
DARWIN_API_KEY=""

# EV image generation (optional). EV generates REAL post/ad graphics using the
# SAME Gemini/OpenAI key as the text brain — no extra credentials needed. The
# provider is inferred (Gemini preferred); override provider/model here. Do not
# hard-code obsolete model names — set EV_IMAGE_MODEL to a current image model.
EV_IMAGE_PROVIDER=""   # "gemini" | "openai" (blank = auto)
EV_IMAGE_MODEL=""      # e.g. gemini-2.5-flash-image | gpt-image-1

# Magic Hour AI (optional) — high-quality image + VIDEO generation for EV.
# Get a key at magichour.ai (Developer/API). Server-side only. When set, EV
# prefers Magic Hour for images and can generate reels/video (ev_video).
MAGICHOUR_API_KEY=""
MAGICHOUR_BASE_URL="https://api.magichour.ai"
# Optional video model override (e.g. kling-3.0, sora-2); blank = Magic Hour default.
MAGICHOUR_VIDEO_MODEL=""

# --- DARWIN lead generation & CRM (optional) -----------------------------
# Google Places (New Places API) is the primary REAL lead source. Without it
# (and with no CSV/manual leads) DARWIN shows "NO REAL DATA AVAILABLE — CONNECT
# A DATA SOURCE" — it NEVER fabricates businesses. Enable "Places API (New)" in
# Google Cloud and restrict the key. Email outreach reuses the Google (Gmail)
# integration you already connect. Server-side only.
GOOGLE_PLACES_API_KEY=""
# Production guard — real data only. Keep MOCK_DATA=false.
APP_ENV="production"
MOCK_DATA="false"
