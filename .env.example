# ==========================================================================
# JARVIS AI — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# JARVIS degrades gracefully: missing keys disable the related capability
# (voice / search / weather) but the rest of the app keeps working.
# ==========================================================================

# --- Database (required) -------------------------------------------------
# PostgreSQL connection string. Works with Supabase, Neon, RDS, or local PG.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/jarvis?schema=public"

# --- Auth (required) -----------------------------------------------------
# Secret used to sign session JWTs. Generate with: openssl rand -base64 48
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
# Public base URL of the app (used for OAuth callbacks). No trailing slash.
APP_URL="http://localhost:3000"

# --- AI model (required for reasoning) -----------------------------------
# JARVIS supports multiple providers. Pick ONE:
#
#   AI_PROVIDER=gemini    -> set GEMINI_API_KEY   (FREE at aistudio.google.com)
#   AI_PROVIDER=groq      -> set GROQ_API_KEY     (FREE at console.groq.com)
#   AI_PROVIDER=ollama    -> local models, unlimited & private (needs Ollama)
#   AI_PROVIDER=openai    -> set OPENAI_API_KEY   (+ optional OPENAI_BASE_URL)
#   AI_PROVIDER=anthropic -> set AI_API_KEY       (paid, console.anthropic.com)
#
# Switch quickly with:  npm run use:groq  |  npm run use:ollama
# (For the deployed app, change AI_PROVIDER in the Vercel dashboard instead.)
#
# AUTOMATIC FALLBACK: set several keys and JARVIS uses AI_PROVIDER first, then
# automatically falls back to any other configured provider when one is rate-
# limited or errors. Combining free tiers (Groq + Gemini + OpenRouter) makes it
# effectively never run out. Order tried: groq -> gemini -> openrouter ->
# openai -> anthropic -> ollama (skipping any without a key).
#
# If AI_PROVIDER is blank, it is inferred from whichever key below is present.
AI_PROVIDER="groq"
# Which brain each agent uses — a provider id (or a comma list, tried in that
# order) = only those, "auto" = the chain above. Defaults: JARVIS, EV and
# DARWIN use Groq, with Gemini as the backup ("ollama" = your PC brain only).
# ULTRON runs on your PC's Ollama — set in edith/.env (ULTRON_AI_PROVIDER).
# JARVIS_PROVIDER="groq,gemini"
# EV_PROVIDER="groq,gemini"
# DARWIN_PROVIDER="groq,gemini"
# MIKE_PROVIDER="groq,gemini"   # MIKE: Groq first, Gemini as the backup
# RUBIN_PROVIDER="groq,gemini"  # RUBIN (sales & CRM): Groq first, Gemini as the backup
# MIKE_VOICE_ID=""   # ElevenLabs voice for MIKE (default "Brian")

# Google Gemini (recommended free option). Uses the OpenAI-compatible endpoint.
GEMINI_API_KEY=""

# Groq (free, very fast). Runs Llama models with tool-calling.
GROQ_API_KEY=""

# OpenRouter (one key, many models — including free ones). Great as a fallback.
# Get a key at https://openrouter.ai/keys. Optionally pin a model:
OPENROUTER_API_KEY=""
OPENROUTER_MODEL=""   # default: meta-llama/llama-3.3-70b-instruct:free

# Ollama (local, unlimited, private). Install from ollama.com, then:
#   ollama pull qwen2.5-coder:7b   (tool-capable, good at code; OLLAMA_MODEL to change)
# Only reachable from where the app runs — great for local dev; the Vercel
# deployment can't reach your localhost unless you expose it via a tunnel.
OLLAMA_BASE_URL="http://localhost:11434/v1"

# OpenAI or any OpenAI-compatible endpoint.
OPENAI_API_KEY=""
OPENAI_BASE_URL=""

# Anthropic (paid). Powerful, native PDF/vision support.
AI_API_KEY=""

# Optional model override. Sensible per-provider defaults are used if blank:
#   gemini -> gemini-3.6-flash | groq -> llama-3.3-70b-versatile
#   openai -> gpt-4o-mini      | anthropic -> claude-sonnet-5
AI_MODEL=""

# --- Your own Ollama brain (unlimited, runs on your PC) -----------------------
# Run `npm run brain` inside the edith/ folder (ULTRON's runtime) on your PC. It registers its tunnel URL with
# this app automatically; you only set the shared key below, once. While your PC
# is online JARVIS/EV/DARWIN use it first; when it's off, the cloud keys above
# take over automatically.
OLLAMA_API_KEY=""
# Only if you host Ollama at a fixed public URL yourself (normally leave blank):
# OLLAMA_BASE_URL=""
# OLLAMA_MODEL="qwen2.5-coder:7b"

# --- ElevenLabs Voice (optional) -----------------------------------------
# Server-side only. Never exposed to the browser.
ELEVENLABS_API_KEY=""
# Voice used for JARVIS speech. Configurable — do not hard-code in code.
ELEVENLABS_VOICE_ID=""
# Distinct per-agent voices so each assistant is recognizable by ear. Optional —
# sensible defaults are used if unset. (The FREE browser voice also picks a
# different system voice per agent when no ElevenLabs key is configured.)
ULTRON_VOICE_ID=""   # (formerly EDITH_VOICE_ID — the old name still works)
# ULTRON's delivery (it's also darkened in the browser — see README "ULTRON's voice"):
# ULTRON_VOICE_STYLE=0.65      # 0–1, more = more dramatic
# ULTRON_VOICE_STABILITY=0.28  # 0–1, less = more restless / menacing
# ULTRON_VOICE_SPEED=0.92      # 0.7–1.2
EV_VOICE_ID=""
DARWIN_VOICE_ID=""
# Low-latency conversational model. eleven_turbo_v2_5 recommended.
ELEVENLABS_MODEL_ID="eleven_turbo_v2_5"
# Speech-to-text model for microphone transcription.
ELEVENLABS_STT_MODEL_ID="scribe_v1"

# --- Web Search (optional) -----------------------------------------------
# Tavily API key (https://tavily.com) powers the web_search tool.
SEARCH_API_KEY=""

# --- Weather (optional) --------------------------------------------------
# OpenWeatherMap API key (https://openweathermap.org/api).
WEATHER_API_KEY=""

# --- OAuth integrations (optional) ---------------------------------------
# Only fill these for integrations you want to enable. Left blank => disabled.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
SLACK_CLIENT_ID=""
SLACK_CLIENT_SECRET=""
NOTION_CLIENT_ID=""
NOTION_CLIENT_SECRET=""

# --- EV marketing agent (optional) ---------------------------------------
# EV is JARVIS's marketing/growth agent for Infinity Web & Apps. It reuses the
# same AI provider chain and voice above — these vars only add its integrations.
#
# Instagram: EV can read profile/media/insights and (after your approval)
# publish. Two token flavors are auto-detected:
#   - "Instagram API with Instagram Login" tokens start with "IG" and use
#     graph.instagram.com; INSTAGRAM_BUSINESS_ID may be left blank ("me").
#   - Facebook-linked Instagram Graph API tokens need INSTAGRAM_BUSINESS_ID.
# Server-side only — never exposed to the browser.
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_BUSINESS_ID=""
INSTAGRAM_GRAPH_VERSION="v21.0"
# DARWIN lead-discovery service (optional). If unset, EV honestly reports that
# lead discovery isn't connected and never invents businesses or phone numbers.
DARWIN_API_URL=""
DARWIN_API_KEY=""

# EV image generation (optional). EV generates REAL post/ad graphics using the
# SAME Gemini/OpenAI key as the text brain — no extra credentials needed. The
# provider is inferred (Gemini preferred); override provider/model here. Do not
# hard-code obsolete model names — set EV_IMAGE_MODEL to a current image model.
EV_IMAGE_PROVIDER=""   # "gemini" | "openai" (blank = auto) — only used with EV_MEDIA_PROVIDER=auto
EV_IMAGE_MODEL=""      # e.g. gemini-2.5-flash-image | gpt-image-1

# Magic Hour AI — EV makes ALL its images and videos with Magic Hour (chat
# requests, and the daily post image + Reel clip). Get a key at magichour.ai →
# Developer → API key. Server-side only. (MAGIC_HOUR_API_KEY also works.)
MAGICHOUR_API_KEY=""
MAGICHOUR_BASE_URL="https://api.magichour.ai"
# "magichour" (default) = Magic Hour only — without a key EV says so instead of
# using another generator. "auto" = Magic Hour first, Gemini/OpenAI images as backup.
# EV_MEDIA_PROVIDER="magichour"
# Optional overrides — blank = Magic Hour's recommended model:
MAGICHOUR_IMAGE_MODEL=""        # e.g. flux-schnell, z-image-turbo, nano-banana, gpt-image-2
MAGICHOUR_IMAGE_RESOLUTION=""   # 640px | 1k | 2k | 4k (model-dependent)
MAGICHOUR_VIDEO_MODEL=""        # e.g. kling-3.0, ltx-2.5, seedance-2.0, veo3.1
MAGICHOUR_VIDEO_RESOLUTION=""   # 480p | 720p | 1080p

# --- DARWIN lead generation & CRM (optional) -----------------------------
# Google Places (New Places API) is the primary REAL lead source. Without it
# (and with no CSV/manual leads) DARWIN shows "NO REAL DATA AVAILABLE — CONNECT
# A DATA SOURCE" — it NEVER fabricates businesses. Enable "Places API (New)" in
# Google Cloud and restrict the key. Email outreach reuses the Google (Gmail)
# integration you already connect. Server-side only.
GOOGLE_PLACES_API_KEY=""
# DARWIN "FIND NEW LEADS" — Geoapify Places (free tier: 3,000 credits/day, no
# credit card). Powers the dashboard search, deduplicated lead history and the
# darwin_search tool. Server-side only — never exposed to the browser. Get a key
# at https://myprojects.geoapify.com (sign up → New Project → API key).
GEOAPIFY_API_KEY=""

# --- NIOS board watcher ---------------------------------------------------------
# JARVIS watches the official NIOS pages (main site, Secondary & Sr. Secondary,
# Vocational, Results) and alerts you to new notices: in the console (pop-up +
# voice + desktop notification) and by email when Gmail is connected.
# Secret Vercel Cron sends to /api/cron/nios (any long random string).
CRON_SECRET=""
# Also watch these regional centres (rc<name>.nios.ac.in), e.g. "delhi,chennai".
# (Regional Centre Bengaluru is always watched.)
NIOS_REGIONAL_CENTRES=""
# Extra official NIOS pages to watch (comma-separated, must be on nios.ac.in).
NIOS_EXTRA_URLS=""
# Foursquare Places — alternative source. NOTE: its "free" tier now requires
# billing credits (a card), so Geoapify above is the better free option.
FOURSQUARE_API_KEY=""
# Foursquare Places API version header (date-stamped). Leave as-is unless the
# provider tells you to bump it.
FOURSQUARE_API_VERSION="2025-06-17"
# No key needed for OpenStreetMap Overpass — it's the always-on free fallback
# used automatically when no keyed source returns results. Best-effort/shared
# public endpoint; a keyed source above gives richer, faster data.
# Production guard — real data only. Keep MOCK_DATA=false.
APP_ENV="production"
MOCK_DATA="false"

# --- EV daily content -----------------------------------------------------------
# Every morning EV prepares today's Instagram post + Reel for your approval
# (runs from /api/cron/ev-daily — uses CRON_SECRET above — `npm run local`, and
# the open console). Nothing publishes without your approval unless
# EV_DAILY_AUTOPUBLISH=on. All optional.
EV_DAILY=""                 # "off" to disable
EV_DAILY_TZ=""              # default Asia/Kolkata
EV_DAILY_START=""           # default 04:00
EV_DAILY_READY_BY=""        # default 05:30
EV_DAILY_POST_TIME=""       # default 19:00 (planned posting time)
EV_DAILY_AUTOPUBLISH=""     # "on" = publish at the posting time without asking
EV_DAILY_VIDEO=""           # auto | motion | magichour
FFMPEG_PATH=""              # default: bundled ffmpeg-static

# --- DARWIN daily lead search --------------------------------------------------
# DARWIN finds N new, verified no-website leads every day in your target
# locations (also editable in DARWIN's daily-search settings). Verification is
# strongest with GOOGLE_PLACES_API_KEY and SEARCH_API_KEY set. All optional.
DARWIN_DAILY=""             # "off" to disable
DARWIN_DAILY_TZ=""          # default: EV_DAILY_TZ or Asia/Kolkata
DARWIN_DAILY_START=""       # default 06:00
DARWIN_DAILY_TARGET=""      # default 50
DARWIN_DAILY_LOCATIONS=""   # e.g. "Indiranagar, Bengaluru; Koramangala, Bengaluru"
DARWIN_DAILY_CATEGORIES=""  # e.g. "gyms, cafes" (only allowed kinds are kept)
# The daily search covers every area of Bangalore (75 areas, carrying on each day where
# the last one stopped). "false" = search only DARWIN_DAILY_LOCATIONS / your saved locations.
DARWIN_ALL_BANGALORE=""
# Keep searching after the deadline (2 PM) until the day's target is reached. "false" = stop at the deadline.
DARWIN_KEEP_GOING=""
# DARWIN only looks for these kinds of business — default "cafes, restaurants, gyms"; "all" lifts the limit
DARWIN_ONLY_CATEGORIES=""
DARWIN_DAILY_STRICT=""      # "off" = don't require Google / web-search confirmation
DARWIN_EMAIL_TARGET=""      # businesses with an email to find and email each day (default 25, 0 = off)
DARWIN_EMAIL_DEADLINE=""    # all of them emailed by this time (default "18:00")
# Free web searches DARWIN uses to confirm "no website" (more searches = more leads a day).
# Used in this order; set any you have — when one runs out or fails, DARWIN moves to the next.
SEARXNG_URL=""              # your own SearXNG (free, unlimited) — `npm run searxng` sets it up and fills this in
DARWIN_INSTAGRAM=""         # "off" = no "Instagram + No Website Leads" task after the daily search
DARWIN_INSTAGRAM_TARGET=""  # Instagram + No Website leads a day (default 20)
BRAVE_SEARCH_API_KEY=""     # Brave Search API, free plan (~2,000/month)
SERPER_API_KEY=""           # serper.dev (Google results, 2,500 free on sign-up)
DARWIN_BRAVE_MONTHLY=""     # Brave searches spread over each month (default 2000, 0 = no pacing)
DARWIN_SERPER_MONTHLY=""    # Serper searches spread over each month (default 2500, 0 = no pacing)

# --- RUBIN (sales & CRM) — optional ------------------------------------------
RUBIN_VOICE_ID=""         # leave empty: Rubin designs its own voice (ElevenLabs Voice Design); set to force a voice
RUBIN_WEBHOOK_SECRET=""   # set to enable the signed inbound webhook POST /api/robin/webhook
