# ULTRON environment.
# ULTRON's reasoning/coding loop needs at least one AI key. Set SEVERAL: when one
# runs out of free quota, ULTRON automatically moves to the next.
# Test which keys actually work (takes ~10s):   npm run check
GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=        # free tier can require billing (402) — ULTRON skips it then
# OPENAI_API_KEY=

# More FREE options (no credit card):
# MISTRAL_API_KEY=         # console.mistral.ai → API Keys ("Experiment" free plan)
# GITHUB_MODELS_TOKEN=     # github.com/settings/tokens → fine-grained token with "Models: read"
# SAMBANOVA_API_KEY=       # cloud.sambanova.ai → API Keys

# Unlimited + offline: a model on your own PC via Ollama (ollama.com).
# Install Ollama, run `ollama pull qwen2.5-coder:7b`, then:
# OLLAMA_MODEL=qwen2.5-coder:7b
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Make this PC's Ollama the brain for JARVIS, EV and DARWIN too ----------
# Run `npm run brain` (keep the window open). It opens a secure tunnel and tells
# your Vercel app where to find this PC. First run prints OLLAMA_API_KEY=… —
# add that ONCE on Vercel (Settings → Environment Variables) and redeploy.
# JARVIS_URL=https://your-app.vercel.app
# Optional: use a fixed address instead of a free Cloudflare quick tunnel
# (e.g. an ngrok static domain forwarding to port 11500):
# BRAIN_PUBLIC_URL=https://your-name.ngrok-free.app
# BRAIN_PORT=11500
# Speed (defaults are tuned for voice — change only if needed):
# BRAIN_CTX=8192          # context window; 4096 uses less GPU memory
# BRAIN_KEEP_ALIVE=24h    # how long the model stays loaded after a request
# BRAIN_NATIVE=0          # fall back to plain /v1 forwarding (older Ollama)
# For voice, a 3B model answers 2–3× faster than a 7B one on most PCs:
#   ollama pull qwen2.5:3b   →   OLLAMA_MODEL=qwen2.5:3b

# Override any default model: GROQ_MODEL, OPENROUTER_MODEL, MISTRAL_MODEL,
# GITHUB_MODELS_MODEL, SAMBANOVA_MODEL, GEMINI_MODEL, CEREBRAS_MODEL

# Which project ULTRON works in (an existing repo, or leave blank for ./workspaces):
# ULTRON_WORKSPACE=/absolute/path/to/your/project

# Optional:
# ULTRON uses Groq, with Gemini as the backup, by default. GROQ_API_KEY / GEMINI_API_KEY are
# also read from the app's .env.local, so you only need them here if those are empty.
# A provider id or comma list (e.g. ollama, or groq,gemini) = only those, in that order;
# "auto" = every configured provider with automatic fallback.
# ULTRON_AI_PROVIDER=groq,gemini
# ULTRON_PORT=7420
# ULTRON_TOKEN=            # pin a stable pairing token (so you pair once, forever)
# Origins allowed to AUTO-READ the pairing token over http://127.0.0.1:PORT/pair.
# The local dashboard (localhost:3000) is always allowed. To let your DEPLOYED
# app auto-pair without copy/paste, add its URL here (comma-separated). Any other
# site is refused (403), so it can't silently grab the token.
# ULTRON_ALLOWED_ORIGINS=https://your-app.vercel.app

# Deployment providers (only set the ones you actually use — ULTRON shows them as
# "connected" only when present, and never fakes a deploy):
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=
# CLOUDFLARE_API_TOKEN=
# Raise if ULTRON writes large files and JSON gets cut off (default 8192).
# ULTRON_MAX_TOKENS=8192
