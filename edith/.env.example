# EDITH environment.
# Reuse your JARVIS AI keys — EDITH's reasoning/coding loop needs at least one.
GROQ_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Which project EDITH works in (an existing repo, or leave blank for ./workspaces):
# EDITH_WORKSPACE=/absolute/path/to/your/project

# Optional:
# EDITH_AI_PROVIDER=groq
# EDITH_PORT=7420
# EDITH_TOKEN=            # pin a stable pairing token (so you pair once, forever)
# Origins allowed to AUTO-READ the pairing token over http://127.0.0.1:PORT/pair.
# The local dashboard (localhost:3000) is always allowed. To let your DEPLOYED
# app auto-pair without copy/paste, add its URL here (comma-separated). Any other
# site is refused (403), so it can't silently grab the token.
# EDITH_ALLOWED_ORIGINS=https://your-app.vercel.app

# Deployment providers (only set the ones you actually use — EDITH shows them as
# "connected" only when present, and never fakes a deploy):
# VERCEL_TOKEN=
# NETLIFY_AUTH_TOKEN=
# CLOUDFLARE_API_TOKEN=
