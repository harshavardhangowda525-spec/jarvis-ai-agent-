# JARVIS Operator environment.
# Provide at least ONE AI provider key (same keys as your JARVIS web app).
GROQ_API_KEY=
# GEMINI_API_KEY=
# CEREBRAS_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=

# Optional overrides:
# AI_PROVIDER=groq
# GROQ_MODEL=openai/gpt-oss-120b
# OPERATOR_PORT=7317
# OPERATOR_PROFILE_DIR=./browser-data
# OPERATOR_CHROME_PATH=
# OPERATOR_TOKEN=            # set to pin a stable pairing token

# --- JARVIS CRM: Google Maps lead finder -----------------------------------------
# With `npm run local` you don't need these: press "Connect this laptop" in
# JARVIS → CRM and JARVIS hands the operator its token (operator/.finder.json).
# Only when JARVIS runs somewhere else (e.g. Vercel), paste what the CRM shows:
# JARVIS_URL=https://your-jarvis.vercel.app
# JARVIS_FINDER_TOKEN=jmf_...
# OPERATOR_MAPS=off          # turn the finder off
