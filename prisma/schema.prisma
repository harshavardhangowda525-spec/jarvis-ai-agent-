// JARVIS AI — Prisma schema
// PostgreSQL (Supabase / Neon / RDS / local). Per-user isolation enforced in
// application layer; RLS-friendly design (every user-owned row carries userId).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile             Profile?
  voicePreference     VoicePreference?
  conversations       Conversation[]
  messages            Message[]
  memories            Memory[]
  tasks               Task[]
  notes               Note[]
  toolLogs            ToolLog[]
  integrations        Integration[]
  sessions            Session[]
  evContents          EvContent[]
  evMedia             EvMedia[]
  darwinLeads         DarwinLead[]
  darwinActivities    DarwinActivity[]
  darwinFollowUps     DarwinFollowUp[]
  darwinMessages      DarwinMessage[]
  darwinSearchCursors DarwinSearchCursor[]
  niosNotices         NiosNotice[]
  activityEvents      ActivityEvent[]
  evDaily             EvDaily[]
  darwinDailyRuns     DarwinDailyRun[]
  darwinCandidates    DarwinCandidate[]
  darwinIgRuns        DarwinIgRun[]
  darwinIgLeads       DarwinIgLead[]
  darwinIgChecks      DarwinIgCheck[]
  dailySummaries      DailySummary[]
  mikeSignals         MikeSignal[]
  mikeAlerts          MikeAlert[]
  robinLeads          RobinLead[]
  robinSettings       RobinSettings?
  gateCredentials     GateCredential[]
  gateSecurity        GateSecurity?
  faceTemplates       FaceTemplate[]
  astonIncidents      AstonIncident[]
  astonSites          AstonSite[]

  @@index([email])
}

model Profile {
  id            String   @id @default(cuid())
  userId        String   @unique
  displayName   String?
  assistantName String   @default("JARVIS")
  timezone      String   @default("UTC")
  language      String   @default("en")
  theme         String   @default("dark")
  aiProvider    String? // preferred primary AI brain (e.g. groq, gemini, cerebras); null = use env default
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VoicePreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  voiceId      String? // ElevenLabs voice id override (falls back to env)
  voiceEnabled Boolean  @default(true)
  autoListen   Boolean  @default(true)
  speakingRate Float    @default(1.0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique // jti claim of the issued JWT
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())
  expiresAt DateTime
  revokedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenId])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("New conversation")
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([userId, archived, updatedAt])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  role           String // user | assistant | tool | system
  content        String   @db.Text
  // Structured tool-call / tool-result payloads (JSON) for replay + audit.
  toolCalls      Json?
  toolResults    Json?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([userId])
}

model Memory {
  id        String   @id @default(cuid())
  userId    String
  key       String? // optional short label, e.g. "company"
  content   String   @db.Text
  source    String   @default("user") // user | agent
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Task {
  id          String    @id @default(cuid())
  userId      String
  title       String
  details     String?   @db.Text
  status      String    @default("pending") // pending | done
  priority    String    @default("normal") // low | normal | high
  dueAt       DateTime?
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

model Note {
  id        String   @id @default(cuid())
  userId    String
  title     String   @default("Untitled note")
  content   String   @db.Text
  tags      String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ToolLog {
  id         String   @id @default(cuid())
  userId     String
  tool       String
  input      Json?
  output     Json?
  status     String   @default("ok") // ok | error | denied
  error      String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// EV marketing agent's persistent memory: every piece of content, idea,
/// campaign note and outreach draft it produces, with a status lifecycle and a
/// normalized `fingerprint` used to reject near-duplicate ideas before they are
/// generated again. Per-user isolated.
model EvContent {
  id          String    @id @default(cuid())
  userId      String
  // post | reel | story | caption | hook | cta | ad | educational | growth |
  // website | app | idea | outreach | campaign | note
  kind        String
  // draft | ready | approved | rejected | scheduled | published | failed
  status      String    @default("draft")
  niche       String? // gyms | cafes | restaurants | salons | ...
  theme       String? // content theme / angle
  title       String    @default("")
  caption     String?   @db.Text
  hook        String?   @db.Text
  cta         String?   @db.Text
  body        String?   @db.Text // full script / preview / message body
  fingerprint String // normalized hash for near-duplicate detection
  metadata    Json?
  scheduledAt DateTime?
  publishedAt DateTime?
  externalId  String? // e.g. Instagram media id after a confirmed publish
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind, status])
  @@index([userId, createdAt])
  @@index([userId, fingerprint])
}

/// Images EV generates. Stored as bytes so the app can serve them at a stable
/// public URL (required for Instagram publishing, which fetches image_url). The
/// id is an unguessable cuid that acts as the capability to fetch the bytes.
model EvMedia {
  id        String   @id @default(cuid())
  userId    String
  mimeType  String   @default("image/png")
  data      Bytes
  prompt    String   @db.Text
  width     Int?
  height    Int?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// DARWIN — real lead / CRM record for Infinity Web & Apps. Every row is a REAL
/// business from a connected source (Google Places, CSV import, user-provided).
/// `verifiedFields` lists which fields are source-verified facts vs AI analysis.
/// `fingerprint` (domain / phone / name+location) enforces duplicate protection.
model DarwinLead {
  id              String    @id @default(cuid())
  userId          String
  businessName    String
  category        String?
  location        String?
  website         String?
  phone           String?
  email           String?
  instagram       String?
  // Provenance
  source          String    @default("manual") // google_places | csv | manual | instagram | ...
  sourceRef       String? // place_id / row id / URL the data came from
  sourceUrl       String?
  discoveredAt    DateTime  @default(now())
  lastVerifiedAt  DateTime?
  // Location (real coordinates from the source — never guessed)
  latitude        Float?
  longitude       Float?
  // Seen again in a later discovery (dedup keeps firstDiscovered = discoveredAt)
  lastSeenAt      DateTime?
  // CRM
  stage           String    @default("new") // new|contacted|follow_up|interested|not_interested|converted (+ legacy: qualified|replied|demo|proposal|negotiation|won|lost)
  lastContactedAt DateTime?
  salesValue      Float? // expected deal value (user-entered)
  serviceInterest String? // e.g. "Website", "Mobile app" (user-entered)
  assignedTo      String?
  opportunityType String? // no_website | outdated_website | no_app | ... (AI analysis)
  notes           String?   @db.Text
  nextFollowUpAt  DateTime?
  // Which fields are source-VERIFIED facts (the rest of the analysis is AI).
  verifiedFields  String[]  @default([])
  aiAnalysis      String?   @db.Text // clearly-labeled AI opportunity analysis
  leadScore       Int? // AI analysis, never presented as verified fact
  fingerprint     String
  metadata        Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities DarwinActivity[]
  followUps  DarwinFollowUp[]
  messages   DarwinMessage[]

  @@index([userId, stage, nextFollowUpAt])
  @@index([userId, discoveredAt])
  @@index([userId, fingerprint])
  @@index([userId, sourceRef])
}

// Where a "FIND NEW LEADS" search left off, so the next click continues the
// discovery instead of re-reading the same first results. One row per user +
// normalized (category, location, filter, radius).
model DarwinSearchCursor {
  id          String   @id @default(cuid())
  userId      String
  queryKey    String
  category    String
  location    String
  filter      String   @default("all")
  centerLat   Float?
  centerLon   Float?
  placeLabel  String?
  baseRadiusM Int      @default(5000)
  radiusStep  Int      @default(0) // index into the widening-radius schedule
  offset      Int      @default(0) // Geoapify result offset within the current radius
  exhausted   Boolean  @default(false)
  backlog     Json? // qualifying leads found but not yet shown (returned next time)
  totalNew    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, queryKey])
}

/// Real activity log — only actual events (discovered, stage change, message sent…).
model DarwinActivity {
  id        String   @id @default(cuid())
  userId    String
  leadId    String?
  type      String // discovered | qualified | stage_changed | note | message_drafted | message_sent | message_failed | reply_received | followup_scheduled | followup_completed
  detail    String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead DarwinLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

model DarwinFollowUp {
  id          String    @id @default(cuid())
  userId      String
  leadId      String
  dueAt       DateTime
  reason      String?
  message     String?   @db.Text
  priority    String    @default("normal") // low | normal | high
  status      String    @default("pending") // pending | completed | cancelled
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead DarwinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
}

/// Outreach / communication record with REAL delivery states.
model DarwinMessage {
  id         String    @id @default(cuid())
  userId     String
  leadId     String
  channel    String    @default("email") // email | instagram_dm | note
  subject    String?
  body       String    @db.Text
  // draft | approval_required | sending | sent | delivered | failed | replied
  status     String    @default("draft")
  externalId String? // provider message id when actually sent
  error      String?
  createdAt  DateTime  @default(now())
  sentAt     DateTime?

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  lead DarwinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, status, createdAt])
  @@index([leadId, createdAt])
}

model Integration {
  id           String    @id @default(cuid())
  userId       String
  provider     String // gmail | gcalendar | gdrive | github | slack | notion | ...
  status       String    @default("disconnected") // connected | disconnected
  accessToken  String?   @db.Text // encrypted at rest in production
  refreshToken String?   @db.Text
  scope        String?
  expiresAt    DateTime?
  metadata     Json?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

/// NIOS board notices JARVIS has seen on the official NIOS websites. `baseline`
/// rows were already published when watching started (kept as history, never
/// announced); the rest were new and are announced once (seenAt / emailedAt).
model NiosNotice {
  id          String    @id @default(cuid())
  userId      String
  source      String // main | sdmis | voc | results | rc-<centre> | extra
  title       String    @db.Text
  url         String    @db.Text
  dateText    String?
  publishedAt DateTime?
  category    String    @default("general") // exam | result | admission | fee | general
  fingerprint String
  baseline    Boolean   @default(false)
  firstSeenAt DateTime  @default(now())
  seenAt      DateTime?
  emailedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, firstSeenAt])
}

/// MIKE's signal journal: every analysis MIKE produced (a setup or a deliberate
/// NO TRADE), with the evidence at the time. The analysis fields are written
/// once and never changed; only the outcome (resolved from later real candles)
/// and the self-audit are added when the setup finishes.
model MikeSignal {
  id            String    @id @default(cuid())
  userId        String
  asset         String // display name, e.g. "BTC/USDT"
  symbol        String // provider symbol, e.g. "BTCUSDT"
  provider      String // binance | yahoo
  assetGroup    String // correlation bucket
  timeframe     String
  mode          String    @default("mtf")
  decision      String // setup | no_trade
  direction     String? // long | short
  status        String    @default("open") // open | triggered | won | lost | expired | not_triggered | no_trade
  entryLow      Float?
  entryHigh     Float?
  stop          Float?
  targets       Json? // [{ price, basis, rr }]
  riskReward    Float?
  riskPct       Float? // % of the account at risk (from the risk plan)
  confidence    Int
  regime        String?
  freshness     String // live | delayed | closed | stale
  source        String
  priceAtSignal Float?
  reasoning     Json // checks, no-trade reasons, alignment, confidence breakdown
  indicators    Json? // snapshot at the time
  outcome       Json? // { result, exitPrice, targetsHit, rMultiple, mfeR, maeR, bars }
  audit         Json?
  createdAt     DateTime  @default(now())
  triggeredAt   DateTime?
  resolvedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
}

/// Market alerts MIKE watches (price levels, breakouts, volume spikes, new setups…).
/// MIKE only NOTIFIES — it never places orders.
model MikeAlert {
  id            String    @id @default(cuid())
  userId        String
  asset         String
  symbol        String
  provider      String
  timeframe     String    @default("1h")
  kind          String // price_above | price_below | breakout | breakdown | volume_spike | trend_reversal | rsi_above | rsi_below | new_setup
  level         Float?
  note          String?
  status        String    @default("active") // active | triggered | disabled
  lastCheckedAt DateTime?
  triggeredAt   DateTime?
  triggerInfo   Json?
  createdAt     DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// JARVIS's persistent activity history — what happened across every agent,
/// recorded as it happens (never demo data). Feeds the daily briefing.
model ActivityEvent {
  id          String   @id @default(cuid())
  userId      String
  timestamp   DateTime @default(now())
  date        String // YYYY-MM-DD in the user's timezone at the time
  category    String // command | task | development | business | marketing | communication | agent | file | error | solution | decision | notice | conversation
  agent       String // JARVIS | DARWIN | EV | ULTRON | HUMANOID | …
  action      String   @db.Text
  result      String?  @db.Text
  status      String   @default("info") // success | failed | info
  importance  Int      @default(2) // 1 minor … 5 critical
  project     String?
  source      String // chat | tool | darwin | task | ultron | client | nios | ev | user
  metadata    Json?
  fingerprint String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, timestamp])
  @@index([userId, date])
}

/// The structured summary of one day (built at the end of the day and
/// refreshed if more activity for that day is recorded later).
model DailySummary {
  id          String    @id @default(cuid())
  userId      String
  date        String // YYYY-MM-DD
  timezone    String
  data        Json
  narrative   String    @db.Text
  stats       Json
  eventCount  Int
  lastEventAt DateTime?
  generatedAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// EV's daily content package — the Instagram post + Reel EV prepares every
/// morning (by 5:30 AM) for your approval. One row per version: rejecting or
/// revising creates the next version and keeps the old one as history. Assets
/// are real EvMedia rows; `log` holds the true timeline of every step.
model EvDaily {
  id              String    @id @default(cuid())
  userId          String
  date            String // YYYY-MM-DD the content is for (EV_DAILY_TZ)
  version         Int       @default(1)
  current         Boolean   @default(true)
  // draft | generating | ready | approved | published | rejected | failed
  status          String    @default("draft")
  // plan | rewrite_caption | rewrite_tone | rewrite_video | image | image_wait | video | video_wait | qc | ready | publishing | done
  stage           String    @default("plan")
  trigger         String    @default("schedule") // schedule | manual | reject | regenerate | another | caption | tone | video | retry
  instruction     String?   @db.Text
  contentType     String    @default("Reel + post")
  niche           String?
  service         String?
  format          String?
  topic           String    @default("")
  angle           String?   @db.Text
  hook            String?   @db.Text
  caption         String?   @db.Text
  cta             String?
  hashtags        String[]
  beats           String[]
  creativeConcept String?   @db.Text
  videoConcept    String?   @db.Text
  imagePrompt     String?   @db.Text
  imageMediaId    String?
  imageUrl        String?
  imageProvider   String?
  videoMediaId    String?
  videoUrl        String?
  videoSeconds    Float?
  videoProvider   String?
  videoBaseId     String? // Magic Hour clip (EvMedia) the Reel was cut from
  jobId           String? // Magic Hour project id while an image / clip renders
  variant         Int       @default(0) // Reel motion style
  postingTime     String? // HH:MM planned, local
  qc              Json?
  error           String?   @db.Text
  attempts        Int       @default(0)
  log             Json?
  contentId       String? // mirror in EvContent (EV memory)
  postMediaId     String?
  reelContainerId String?
  reelMediaId     String?
  publishError    String?   @db.Text
  lockedUntil     DateTime?
  readyAt         DateTime?
  approvedAt      DateTime?
  publishedAt     DateTime?
  rejectedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, version])
  @@index([userId, date, current])
  @@index([userId, createdAt])
}

/// DARWIN's autonomous daily search: one row per user per local day. Holds the
/// resumable position (which location × category, via DarwinSearchCursor), the
/// true counters, the log and the final report. Survives restarts.
model DarwinDailyRun {
  id              String    @id @default(cuid())
  userId          String
  date            String // YYYY-MM-DD in DARWIN_DAILY_TZ
  target          Int       @default(50)
  // running | completed | partial | paused | needs_setup | failed
  status          String    @default("running")
  config          Json // locations, categories, radius, verification settings used
  comboIndex      Int       @default(0)
  exhaustedCombos String[]  @default([])
  verified        Int       @default(0)
  candidates      Int       @default(0)
  duplicates      Int       @default(0)
  alreadyChecked  Int       @default(0)
  websiteRejected Int       @default(0)
  unclear         Int       @default(0)
  tempUnavailable Int       @default(0)
  closed          Int       @default(0)
  missingPhone    Int       @default(0)
  /// email outreach goal for the day (no-website businesses WITH a public email, each emailed by the deadline)
  emailTarget     Int       @default(0)
  /// verified no-website businesses skipped for the email goal because no public email could be found
  missingEmail    Int       @default(0)
  outOfArea       Int       @default(0)
  errors          Int       @default(0)
  apiRequests     Json? // { geoapify, google, search }
  reasons         String[]  @default([])
  log             Json?
  report          Json?
  lastError       String?   @db.Text
  lockedUntil     DateTime?
  startedAt       DateTime  @default(now())
  completedAt     DateTime?
  reportedAt      DateTime?
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId, startedAt])
}

/// Every business DARWIN has checked but not saved (it had a website, was
/// unclear, closed…), so the same place isn't re-verified every day. Unclear /
/// temporarily-unavailable results are re-checked after a cool-off.
model DarwinCandidate {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  placeId     String?
  name        String
  category    String?
  address     String?
  status      String // website_exists | unclear | temporarily_unavailable | closed | no_phone | out_of_area
  website     String?
  reasons     String[] @default([])
  runDate     String
  checkedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, placeId])
}

// ============================================================================
// ROBIN — Sales & CRM. Robin's work starts after DARWIN finds a business:
// qualify → contact → follow up → demo → quotation → negotiate → won/lost → client.
// Every row is a real record (nothing is simulated). Robin's own copy of a lead
// survives even if the DARWIN lead is deleted, so the sales history is never lost.
// ============================================================================

/// A prospect Robin manages (usually handed over by DARWIN).
model RobinLead {
  id               String    @id @default(cuid())
  userId           String
  darwinLeadId     String? // the DARWIN lead it came from (no FK: CRM history outlives it)
  darwinAliases    String[]  @default([]) // other DARWIN records found to be this same business
  number           Int? // the lead's short number for this user (1, 2, 3 …) — "follow up with 7"
  businessName     String
  category         String?
  phone            String?
  whatsapp         String?
  email            String?
  website          String?
  instagram        String?
  address          String?
  city             String?
  mapsUrl          String?
  websiteStatus    String? // no_website | has_website | outdated | poor | unknown
  websiteQuality   String?
  opportunityType  String?
  darwinScore      Int? // DARWIN's own lead score (a prioritisation hint, never a prediction)
  rating           Float?
  reviews          Int?
  source           String    @default("darwin") // darwin | manual | webhook
  discoveredAt     DateTime?
  fingerprint      String // normalised name + city, for duplicate detection
  phoneKey         String? // last 10 digits, for duplicate detection
  // Qualification — an internal prioritisation tool, NOT a prediction of a sale
  priority         String    @default("needs_review") // high | medium | low | needs_review
  priorityOverride String? // set by the user; wins over the computed one
  score            Int       @default(0)
  reasons          Json? // [{ label, points }]
  qualifiedAt      DateTime?
  // Sales
  stage            String    @default("new")
  stageChangedAt   DateTime  @default(now())
  potentialValue   Float? // user-entered, or the latest quotation's total
  serviceInterest  String?
  assignedTo       String?
  lastContactAt    DateTime?
  nextFollowUpAt   DateTime?
  notes            String?   @db.Text
  lostReason       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  scores       RobinLeadScore[]
  stageChanges RobinStageChange[]
  activities   RobinActivity[]
  interactions RobinInteraction[]
  followUps    RobinFollowUp[]
  demos        RobinDemo[]
  quotations   RobinQuotation[]
  client       RobinClient?

  @@unique([userId, darwinLeadId])
  @@unique([userId, number])
  @@index([userId, stage])
  @@index([userId, fingerprint])
  @@index([userId, phoneKey])
  @@index([userId, email])
}

/// Every qualification Robin ran (score history with its reasons).
model RobinLeadScore {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  score     Int
  priority  String
  reasons   Json
  createdAt DateTime @default(now())

  lead RobinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
}

/// Complete history of every stage change.
model RobinStageChange {
  id        String   @id @default(cuid())
  userId    String
  leadId    String
  fromStage String?
  toStage   String
  source    String // user | voice | robin | darwin | system
  note      String?
  createdAt DateTime @default(now())

  lead RobinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

/// Robin's timeline / live activity feed — only things that really happened.
model RobinActivity {
  id        String   @id @default(cuid())
  userId    String
  leadId    String?
  type      String // imported | qualified | stage | call | whatsapp | instagram | email | reply | followup_* | demo_* | quotation_* | client_* | payment | note
  detail    String   @db.Text
  meta      Json?
  createdAt DateTime @default(now())

  lead RobinLead? @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([leadId, createdAt])
}

/// Calls and messages (phone, WhatsApp, Instagram, email). `status` is the
/// TRUE state: "opened" = the app/dialer was opened (nothing confirmed),
/// "logged" = you recorded it, "sent"/"delivered" only when an API confirmed it.
model RobinInteraction {
  id         String   @id @default(cuid())
  userId     String
  leadId     String
  channel    String // call | whatsapp | instagram | email
  direction  String   @default("outbound") // outbound | inbound
  outcome    String? // call: no_answer | busy | wrong_number | spoke | interested | not_interested | call_later | wants_demo | wants_quotation; message: replied | no_reply | …
  status     String   @default("logged") // opened | logged | sent | delivered | failed | received
  subject    String?
  notes      String?  @db.Text
  externalId String?
  occurredAt DateTime @default(now())
  createdAt  DateTime @default(now())

  lead RobinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
  @@index([leadId, occurredAt])
}

/// Follow-up queue (Robin never contacts anyone by itself — these are YOUR tasks).
model RobinFollowUp {
  id          String    @id @default(cuid())
  userId      String
  leadId      String
  action      String    @default("call") // call | whatsapp | email | instagram | meeting | task
  dueAt       DateTime
  priority    String    @default("medium") // high | medium | low
  notes       String?   @db.Text
  status      String    @default("pending") // pending | completed | cancelled
  completedAt DateTime?
  remindedAt  DateTime? // the reminder email went out (once)
  createdAt   DateTime  @default(now())

  lead RobinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, status, dueAt])
  @@index([leadId])
}

model RobinDemo {
  id              String    @id @default(cuid())
  userId          String
  leadId          String
  scheduledAt     DateTime
  demoType        String    @default("online") // online | in_person | phone
  notes           String?   @db.Text
  status          String    @default("scheduled") // scheduled | completed | cancelled | rescheduled
  remindedAt      DateTime?
  emailRemindedAt DateTime? // the reminder email went out (once)
  completedAt     DateTime?
  createdAt       DateTime  @default(now())

  lead RobinLead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId, status, scheduledAt])
}

model RobinQuotation {
  id           String    @id @default(cuid())
  userId       String
  leadId       String
  number       String
  clientName   String?
  status       String    @default("draft") // draft | sent | accepted | rejected | expired
  currency     String    @default("INR")
  subtotal     Float
  discount     Float     @default(0)
  taxPct       Float     @default(0)
  taxAmount    Float     @default(0)
  total        Float
  validUntil   DateTime?
  paymentTerms String?   @db.Text
  notes        String?   @db.Text
  sentAt       DateTime?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  lead  RobinLead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items RobinQuotationItem[]

  @@unique([userId, number])
  @@index([userId, status])
  @@index([leadId])
}

model RobinQuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  service     String
  description String?
  quantity    Float   @default(1)
  unitPrice   Float
  amount      Float
  position    Int     @default(0)

  quotation RobinQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
}

/// A converted lead. The lead (with its whole history) stays linked.
model RobinClient {
  id            String    @id @default(cuid())
  userId        String
  leadId        String    @unique
  quotationId   String?
  businessName  String
  contactName   String?
  phone         String?
  email         String?
  project       String?
  service       String?
  amount        Float     @default(0)
  currency      String    @default("INR")
  paymentStatus String    @default("unpaid") // unpaid | partial | paid
  status        String    @default("active") // active | completed | maintenance | inactive
  startDate     DateTime?
  deliveryDate  DateTime?
  notes         String?   @db.Text
  convertedAt   DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  lead     RobinLead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  payments RobinPayment[]

  @@index([userId, status])
}

model RobinPayment {
  id        String   @id @default(cuid())
  userId    String
  clientId  String
  amount    Float
  paidAt    DateTime @default(now())
  method    String?
  note      String?
  createdAt DateTime @default(now())

  client RobinClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([userId, paidAt])
}

/// Services you sell — names and prices are yours to set (no hard-coded prices).
model RobinService {
  id          String  @id @default(cuid())
  userId      String
  name        String
  description String?
  price       Float? // null until you set it
  unit        String? // e.g. "one-time", "per month", "per year"
  active      Boolean @default(true)
  position    Int     @default(0)

  @@unique([userId, name])
  @@index([userId])
}

model RobinSettings {
  id        String   @id @default(cuid())
  userId    String   @unique
  data      Json
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RobinNotification {
  id        String    @id @default(cuid())
  userId    String
  kind      String // darwin_import | followup_due | demo_soon | quotation_expiring | info
  title     String
  body      String?
  leadId    String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt, createdAt])
}

/// Who changed what in the CRM (user, voice, Robin, DARWIN import, webhook).
model RobinAudit {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String?
  source    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Biometric gate (face unlock). The face itself never reaches JARVIS: it is
// matched by the device's own biometric system (Windows Hello, Face ID, Touch ID,
// Android) and JARVIS only stores the public key of a WebAuthn credential that
// the device unlocks after a successful match.
// ---------------------------------------------------------------------------

/// A device credential that unlocks JARVIS after the device verifies your face.
model GateCredential {
  id           String    @id @default(cuid())
  userId       String
  credentialId String    @unique // base64url credential id
  publicKey    Bytes // COSE public key — not biometric data
  counter      BigInt    @default(0)
  transports   String[]
  label        String
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// PIN fallback + failed-attempt lockout for the gate.
model GateSecurity {
  userId      String    @id
  pinHash     String?
  failedCount Int       @default(0)
  lockouts    Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One-time WebAuthn challenges (consumed on use, expire after a few minutes).
model GateChallenge {
  id        String   @id @default(cuid())
  challenge String   @unique
  kind      String // "register" | "unlock"
  userId    String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

/// JARVIS Face ID enrolment: face descriptors (numbers, never images),
/// AES-256-GCM encrypted with a key derived from the server's AUTH_SECRET.
/// One row per user per server key (a PC and Vercel with different secrets
/// each keep their own).
model FaceTemplate {
  id        String   @id @default(cuid())
  userId    String
  keyId     String
  data      Bytes
  iv        Bytes
  tag       Bytes
  samples   Int
  /// capture standard (FACE_TEMPLATE_VERSION); older templates don't unlock
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, keyId])
}

/// DARWIN's secondary daily task "Instagram + No Website Leads": starts only after
/// that day's primary DarwinDailyRun is completed, and never writes to the primary list.
model DarwinIgRun {
  id            String    @id @default(cuid())
  userId        String
  date          String // YYYY-MM-DD in DARWIN_DAILY_TZ (same day as the primary run)
  primaryRunId  String?
  target        Int       @default(20)
  // running | completed | partial | needs_setup
  status        String    @default("running")
  comboIndex    Int       @default(0)
  exhausted     String[]  @default([])
  /// businesses looked at (new to DARWIN)
  found         Int       @default(0)
  igVerified    Int       @default(0)
  noWebsite     Int       @default(0)
  saved         Int       @default(0)
  contactable   Int       @default(0)
  highPotential Int       @default(0)
  duplicates    Int       @default(0)
  /// left out because Instagram or the website absence couldn't be confirmed
  unverified    Int       @default(0)
  noInstagram   Int       @default(0)
  websiteFound  Int       @default(0)
  apiRequests   Json?
  reasons       String[]  @default([])
  log           Json?
  lastError     String?   @db.Text
  lockedUntil   DateTime?
  startedAt     DateTime  @default(now())
  completedAt   DateTime?
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

/// A verified "Instagram + No Website" lead (kept apart from DarwinLead).
model DarwinIgLead {
  id                String   @id @default(cuid())
  userId            String
  runId             String?
  fingerprint       String
  placeId           String?
  businessName      String
  category          String?
  location          String?
  latitude          Float?
  longitude         Float?
  phone             String?
  instagramUsername String
  instagramUrl      String
  /// verified (only verified accounts are saved)
  instagramStatus   String   @default("verified")
  instagramEvidence String[] @default([])
  followers         Int?
  posts             Int?
  instagramActivity String?
  /// no_official_website (only confirmed absences are saved)
  websiteStatus     String   @default("no_official_website")
  websiteReasons    String[] @default([])
  qualityScore      Int      @default(0)
  highPotential     Boolean  @default(false)
  scoreParts        Json?
  source            String
  foundDate         String
  /// not_contacted | contacted | replied | interested | not_interested | converted
  contactStatus     String   @default("not_contacted")
  /// none | scheduled | due | done
  followUpStatus    String   @default("none")
  followUpAt        DateTime?
  notes             String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@unique([userId, instagramUsername])
  @@index([userId, createdAt])
}

/// Businesses the Instagram phase already looked at (so they aren't checked again).
model DarwinIgCheck {
  id          String   @id @default(cuid())
  userId      String
  fingerprint String
  placeId     String?
  name        String
  /// lead | no_instagram | instagram_unverified | website_found | website_unclear | duplicate
  status      String
  reasons     String[] @default([])
  checkedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId, placeId])
}


// ---------------------------------------------------------------------------
// ASTON — the attention manager. ASTON watches real system signals (signed
// build/deploy webhooks, website probes, the other agents' runs and failures,
// deadlines, gate lockouts) and decides when the owner must be interrupted.
// Everything is persisted so a restart never loses an incident or an alert.
// ---------------------------------------------------------------------------

/// One real problem. A repeat of the same problem (same fingerprint) bumps
/// `occurrences` on the open incident instead of creating another one.
model AstonIncident {
  id             String    @id @default(cuid())
  userId         String
  fingerprint    String
  /// `${userId}:${fingerprint}` while open or acknowledged, null once closed.
  /// The unique index makes two open incidents for one problem impossible.
  openKey        String?   @unique
  source         String // github | webhook | probe | darwin | ev | rubin | jarvis | gate | tasks | agents
  kind           String // build_failed | deploy_failed | prod_incident | task_blocked | decision_required | agent_failures | security | deadline_risk | info
  priority       String    @default("normal") // critical | high | normal
  status         String    @default("open") // open | acknowledged | resolved | dismissed
  project        String?
  title          String
  detail         String?   @db.Text
  evidence       Json?
  /// What ASTON already tried: [{ at, action, ok, note }]
  recovery       Json?
  recommendation String?   @db.Text
  /// Short spoken summary (Groq, or a template when the AI is unavailable).
  summary        String?   @db.Text
  aiNote         String?
  /// An action ASTON wants to take that needs the owner's approval.
  pendingAction  Json?
  occurrences    Int       @default(1)
  verified       Boolean   @default(false)
  verifyNote     String?   @db.Text
  firstSeenAt    DateTime  @default(now())
  lastSeenAt     DateTime  @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  resolution     String?   @db.Text
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  alerts    AstonAlert[]
  decisions AstonDecision[]

  @@index([userId, status, priority])
  @@index([userId, fingerprint])
}

/// One delivery attempt chain per incident, channel and round (round 1 is a
/// reminder for an unacknowledged critical incident). The unique index is what
/// stops duplicate alerts.
model AstonAlert {
  id            String    @id @default(cuid())
  incidentId    String
  userId        String
  channel       String // browser | email | phone
  round         Int       @default(0)
  // pending (queued / waiting for a browser) | delivered | failed (will retry) | gave_up | skipped
  status        String    @default("pending")
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lastError     String?   @db.Text
  providerRef   String?
  testMode      Boolean   @default(false)
  costUsd       Float?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  incident AstonIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@unique([incidentId, channel, round])
  @@index([userId, channel, status])
  @@index([status, nextAttemptAt])
}

/// The owner's decisions (acknowledge, resolve, approve, …) — an audit trail.
model AstonDecision {
  id         String   @id @default(cuid())
  incidentId String
  userId     String
  action     String
  note       String?  @db.Text
  result     String?  @db.Text
  createdAt  DateTime @default(now())

  incident AstonIncident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  @@index([incidentId])
}

/// AI provider health + quota, persisted so a rate limit or exhausted free
/// quota is remembered across restarts (no hammering a provider that said no).
model AstonProviderState {
  provider          String    @id // groq
  status            String    @default("ok") // ok | rate_limited | quota_exhausted | outage | auth_error
  blockedUntil      DateTime?
  lastError         String?   @db.Text
  lastOkAt          DateTime?
  day               String? // UTC YYYY-MM-DD the counter below belongs to
  requestsToday     Int       @default(0)
  remainingRequests Int?
  remainingTokens   Int?
  updatedAt         DateTime  @updatedAt
}

/// A website ASTON builds from a brief: planned, styled and written section by
/// section (each step persisted, so a build survives a restart or a rate-limit
/// pause and simply resumes).
model AstonSite {
  id          String    @id @default(cuid())
  userId      String
  title       String
  brief       String    @db.Text
  status      String    @default("building") // building | done | failed
  plan        Json?
  css         String?   @db.Text
  /// The reusable-class guide from the top of the stylesheet (fed to every section).
  guide       String?   @db.Text
  /// [{ id, type, title, brief, html }] — html is null until written.
  sections    Json?
  error       String?   @db.Text
  revisions   Int       @default(0)
  lockedUntil DateTime?
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
